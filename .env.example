# RPC de la red Sepolia. Podés usar un nodo público o uno propio.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Clave privada de la wallet que firma las transacciones (SOLO testnet).
# NUNCA la subas al repositorio: es una clave secreta.
SEPOLIA_PRIVATE_KEY=

# API key de Etherscan (se usa para verificar el contrato).
# La podés obtener gratis en https://etherscan.io/apis
ETHERSCAN_API_KEY=